# Chave opcional da Deadlock API (header X-API-KEY).
#
# Sem ela o site funciona: os limites passam a valer por IP do servidor,
# compartilhados entre todos os visitantes. O endpoint mais restrito é
# /v1/matches/metadata — 30 req/min por IP contra 30 req/10s com chave.
# A chave é concedida pelos mantenedores (Discord/sponsorship da API).
DEADLOCK_API_KEY=

# URL pública do site, usada nos metadados de compartilhamento.
# Na Vercel é detectada automaticamente; defina para um domínio próprio.
NEXT_PUBLIC_SITE_URL=
